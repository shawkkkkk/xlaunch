DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://launchonx.net

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1

# Robinhood Chain / Pons
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Only needed when the launcher selects "Original X author via X Money".
# These are XLaunch-controlled settlement wallets whose receipts/payouts are
# shown in the public fee ledger. Never put a seed phrase or private key here.
XLAUNCH_XMONEY_SOL_TREASURY=
XLAUNCH_XMONEY_EVM_TREASURY=

# Server-only bearer token for recording verified fee/payout ledger events.
XLAUNCH_LEDGER_ADMIN_TOKEN=

# Server-only, 32+ random characters. Signs short-lived reservation challenges.
XLAUNCH_AUTH_SECRET=

# Pump.fun charity routing through Donate.gg.
# Charity search is public; creating donation configs requires a server-only key.
# New Donate.gg developer accounts may require an invitation.
DONATE_GG_API_KEY=
XLAUNCH_DONATE_SOL_TREASURY=


# X social launcher
# Server-only secret used by the X mention ingestion worker when calling
# /api/social/parse. This endpoint never launches by itself.
XLAUNCH_SOCIAL_INGEST_SECRET=

# Optional dedicated 32+ character HMAC secret for stable social confirmation links.
# Falls back to XLAUNCH_AUTH_SECRET when blank.
XLAUNCH_SOCIAL_CONFIRM_SECRET=

# X API credentials will be added when the @launchonx account is connected.
# Do not expose these as NEXT_PUBLIC_ variables.
X_API_BEARER_TOKEN=
X_API_CLIENT_ID=
X_API_CLIENT_SECRET=


# XLaunch bot account. X_BOT_ACCESS_TOKEN must be a user-context OAuth token
# authorized for tweet.read, users.read and tweet.write. Keep server-only.
X_BOT_USER_ID=
X_BOT_ACCESS_TOKEN=

# Protects the mention polling worker endpoint. CRON_SECRET may be used instead.
XLAUNCH_SOCIAL_WORKER_SECRET=

# Optional dedicated 32+ character secret for the short-lived X identity session.
# Falls back to XLAUNCH_AUTH_SECRET.
XLAUNCH_X_SESSION_SECRET=


# Public X automation identity
X_BOT_USERNAME=launchonx
X_AUTOMATION_OPERATOR_HANDLE=ShayanelH


# Embedded wallets (Privy)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=


# Protects /api/market/refresh. CRON_SECRET may be used instead.
XLAUNCH_MARKET_WORKER_SECRET=
