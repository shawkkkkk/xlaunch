DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://xlaunch.it

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1

# Robinhood Chain / Pons
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Only needed when the launcher selects "Original X author via X Money".
# These are XLaunch-controlled settlement wallets whose receipts/payouts are
# shown in the public fee ledger. Never put a seed phrase or private key here.
XLAUNCH_XMONEY_SOL_TREASURY=
XLAUNCH_XMONEY_EVM_TREASURY=

# Server-only bearer token for recording verified fee/payout ledger events.
XLAUNCH_LEDGER_ADMIN_TOKEN=

# Server-only, 32+ random characters. Signs short-lived reservation challenges.
XLAUNCH_AUTH_SECRET=

# Pump.fun charity routing through Donate.gg.
# Charity search is public; creating donation configs requires a server-only key.
# New Donate.gg developer accounts may require an invitation.
DONATE_GG_API_KEY=
XLAUNCH_DONATE_SOL_TREASURY=
